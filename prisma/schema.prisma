generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  password  String
  role      String    @default("user")
  createdAt DateTime  @default(now())
  clients   Client[]
  invoices  Invoice[]
}

model Client {
  id        String    @id @default(cuid())
  name      String
  email     String?
  company   String?
  phone     String?
  address   String?
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id])
  invoices  Invoice[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Invoice {
  id          String       @id @default(cuid())
  number      String
  status      String       @default("draft") // draft | sent | paid | overdue
  issueDate   DateTime     @default(now())
  dueDate     DateTime?
  notes       String?
  clientId    String
  client      Client       @relation(fields: [clientId], references: [id])
  ownerId     String
  owner       User         @relation(fields: [ownerId], references: [id])
  items       InvoiceItem[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model InvoiceItem {
  id          String   @id @default(cuid())
  description String
  quantity    Float    @default(1)
  unitPrice   Float
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
}
